# 로컬 Hardhat 노드 실습(9~11주)에서 deploy.js 출력 주소를 입력 (미설정 시 interact.js 기본 주소 사용)
# CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Sepolia RPC URL (Alchemy 발급 주소를 그대로 사용)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# MetaMask Testnet 전용 계정 개인키 (0x 제외, 64자리 hex)
# ⚠️  절대 실제 자산이 있는 계정 사용 금지
PRIVATE_KEY=your_testnet_private_key_here
